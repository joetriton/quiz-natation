<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>SPE-2 Allure course + finish surge</name>
  <description>1h à 70-74% FTP puis 15 min à 85% (finir fort). Gestion d'effort. | Qualités : Spécifique course (allure cible, gestion d'effort, nutrition) + Durabilité / résistance à la fatigue (tenue de puissance). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="3600" Power="0.72" Cadence="88">
      <textevent timeoffset="0" message="Allure course 70-74% FTP · RPE 4 — nutrition"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.85" Cadence="90">
      <textevent timeoffset="0" message="Finish surge 85% FTP · RPE 6 — finir fort"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
