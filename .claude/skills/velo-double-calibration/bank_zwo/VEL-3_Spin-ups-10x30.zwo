<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>VEL-3 Spin-ups 10x30"</name>
  <description>10x30s à 115-125 rpm sans rebond. Vitesse gestuelle. | Qualités : Vélocité &amp; coordination neuromusculaire (cadence, fluidité) + Puissance neuromusculaire / explosivité (sprint). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
