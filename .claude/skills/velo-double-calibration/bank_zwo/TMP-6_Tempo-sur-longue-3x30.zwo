<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>TMP-6 Tempo sur longue 3x30'</name>
  <description>Sur sortie ~2h15 : 3x30 min à 78-82% FTP. Gros volume tempo full distance. | Qualités : Endurance soutenue sous-seuil (capacité aérobie / tempo) + Durabilité / résistance à la fatigue (tenue de puissance). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="1800" Power="0.8" Cadence="87">
      <textevent timeoffset="0" message="Tempo 78-82% FTP · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.65">
      <textevent timeoffset="0" message="Endurance 62-68% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.8" Cadence="87">
      <textevent timeoffset="0" message="Tempo 78-82% FTP · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.65">
      <textevent timeoffset="0" message="Endurance 62-68% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.8" Cadence="87">
      <textevent timeoffset="0" message="Tempo 78-82% FTP · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.65">
      <textevent timeoffset="0" message="Endurance 62-68% FTP · RPE 3"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
