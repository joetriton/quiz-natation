<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>SEU-4 Seuil 6x1 / 2x4 / 6x1</name>
  <description>Seuil format mixte court-long-court, RPE 7-8. Variété et densité.
Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2→4"/>
    </Warmup>
    <IntervalsT Repeat="3" OnDuration="30" OnPower="1.05" OffDuration="60" OffPower="0.5">
      <textevent timeoffset="0" message="EFFORT — RPE 8 (activation)"/>
      <textevent timeoffset="30" message="RÉCUP — RPE 2"/>
    </IntervalsT>
    <SteadyState Duration="120" Power="0.55">
      <textevent timeoffset="0" message="Transition avant le corps de séance — RPE 2"/>
    </SteadyState>
    <IntervalsT Repeat="6" OnDuration="60" OnPower="1.0" OffDuration="60" OffPower="0.55" Cadence="95">
      <textevent timeoffset="0" message="EFFORT — 1&apos; @ 100% — RPE 7-8"/>
      <textevent timeoffset="60" message="RÉCUP — RPE 2"/>
    </IntervalsT>
    <SteadyState Duration="300" Power="0.52">
      <textevent timeoffset="0" message="Récup bloc — RPE 2"/>
    </SteadyState>
    <IntervalsT Repeat="2" OnDuration="240" OnPower="0.97" OffDuration="180" OffPower="0.52" Cadence="90">
      <textevent timeoffset="0" message="EFFORT — 4&apos; @ 97% — RPE 7-8"/>
      <textevent timeoffset="240" message="RÉCUP — RPE 2"/>
    </IntervalsT>
    <SteadyState Duration="300" Power="0.52">
      <textevent timeoffset="0" message="Récup bloc — RPE 2"/>
    </SteadyState>
    <IntervalsT Repeat="6" OnDuration="60" OnPower="1.0" OffDuration="60" OffPower="0.55" Cadence="95">
      <textevent timeoffset="0" message="EFFORT — 1&apos; @ 100% — RPE 7-8"/>
      <textevent timeoffset="60" message="RÉCUP — RPE 2"/>
    </IntervalsT>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
