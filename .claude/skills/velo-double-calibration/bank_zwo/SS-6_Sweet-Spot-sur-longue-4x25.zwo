<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>SS-6 Sweet Spot sur longue 4x25'</name>
  <description>Sur sortie ~2h30 : 4x25 min à 88-90% FTP. Gros volume sous-seuil full distance. | Qualités : Charge aérobie optimisée (sweet spot) + Durabilité / résistance à la fatigue (tenue de puissance). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="120" Power="0.55">
      <textevent timeoffset="0" message="Transition avant le corps — RPE 2"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.89" Cadence="88">
      <textevent timeoffset="0" message="Sweet Spot 88-90% FTP · RPE 6-7"/>
    </SteadyState>
    <SteadyState Duration="420" Power="0.6">
      <textevent timeoffset="0" message="Endurance 58-62% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.89" Cadence="88">
      <textevent timeoffset="0" message="Sweet Spot 88-90% FTP · RPE 6-7"/>
    </SteadyState>
    <SteadyState Duration="420" Power="0.6">
      <textevent timeoffset="0" message="Endurance 58-62% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.89" Cadence="88">
      <textevent timeoffset="0" message="Sweet Spot 88-90% FTP · RPE 6-7"/>
    </SteadyState>
    <SteadyState Duration="420" Power="0.6">
      <textevent timeoffset="0" message="Endurance 58-62% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.89" Cadence="88">
      <textevent timeoffset="0" message="Sweet Spot 88-90% FTP · RPE 6-7"/>
    </SteadyState>
    <SteadyState Duration="420" Power="0.6">
      <textevent timeoffset="0" message="Endurance 58-62% FTP · RPE 3"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
