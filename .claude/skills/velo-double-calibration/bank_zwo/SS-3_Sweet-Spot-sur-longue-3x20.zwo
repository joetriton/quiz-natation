<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>SS-3 Sweet Spot sur longue 3x20</name>
  <description>Sur sortie longue : 3x20 min à 88-90% FTP, RPE 6. Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="1200" Power="0.7">
      <textevent timeoffset="0" message="Endurance 65-75% FTP · RPE 3-4"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.89" Cadence="88">
      <textevent timeoffset="0" message="Sweet Spot 88-90% FTP · RPE 6"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.68">
      <textevent timeoffset="0" message="Endurance 65-72% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.89" Cadence="88">
      <textevent timeoffset="0" message="Sweet Spot 88-90% FTP · RPE 6"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.68">
      <textevent timeoffset="0" message="Endurance 65-72% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.89" Cadence="88">
      <textevent timeoffset="0" message="Sweet Spot 88-90% FTP · RPE 6"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.68">
      <textevent timeoffset="0" message="Endurance 65-72% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.68">
      <textevent timeoffset="0" message="Retour endurance 65-72% FTP · RPE 3"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
