<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>END-3 Endurance + cadence</name>
  <description>Endurance + vélocité. Blocs à 100-105 rpm. | Qualités : Endurance aérobie fondamentale + Vélocité &amp; coordination neuromusculaire (cadence, fluidité). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="600" Power="0.7" Cadence="103">
      <textevent timeoffset="0" message="68-72% FTP · RPE 4 — 100-105 rpm"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.6" Cadence="90">
      <textevent timeoffset="0" message="55-65% FTP · RPE 2 — cadence libre"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.7" Cadence="103">
      <textevent timeoffset="0" message="68-72% FTP · RPE 4 — 100-105 rpm"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.6" Cadence="90">
      <textevent timeoffset="0" message="55-65% FTP · RPE 2 — cadence libre"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.7" Cadence="103">
      <textevent timeoffset="0" message="68-72% FTP · RPE 4 — 100-105 rpm"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.6" Cadence="90">
      <textevent timeoffset="0" message="55-65% FTP · RPE 2 — cadence libre"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
