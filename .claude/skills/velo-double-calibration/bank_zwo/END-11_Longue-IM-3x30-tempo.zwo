<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>END-11 Longue IM + 3x30' tempo</name>
  <description>Sortie longue ~4h15 avec 3x30' tempo. Volume + tenue d'allure full distance. | Qualités : Durabilité / résistance à la fatigue (tenue de puissance) + Spécifique course (allure cible, gestion d'effort, nutrition). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="3000" Power="0.68" Cadence="86">
      <textevent timeoffset="0" message="Endurance 65-70% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.8" Cadence="86">
      <textevent timeoffset="0" message="Tempo 78-82% FTP · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.66">
      <textevent timeoffset="0" message="Endurance 64-68% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.8" Cadence="86">
      <textevent timeoffset="0" message="Tempo 78-82% FTP · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.66">
      <textevent timeoffset="0" message="Endurance 64-68% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.8" Cadence="86">
      <textevent timeoffset="0" message="Tempo 78-82% FTP · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.66">
      <textevent timeoffset="0" message="Endurance 64-68% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="4200" Power="0.66" Cadence="86">
      <textevent timeoffset="0" message="Endurance retour 64-68% FTP · RPE 3 — nutrition"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
