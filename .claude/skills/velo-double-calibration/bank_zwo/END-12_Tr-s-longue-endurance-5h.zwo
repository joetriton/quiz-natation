<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>END-12 Très longue endurance 5h</name>
  <description>Très longue sortie Z2 ~5h. Durabilité maximale, simulation de durée IM. | Qualités : Endurance aérobie fondamentale + Durabilité / résistance à la fatigue (tenue de puissance). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="16800" Power="0.66" Cadence="85">
      <textevent timeoffset="0" message="Endurance 63-70% FTP · RPE 3 — nutrition +++ / gestion"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
