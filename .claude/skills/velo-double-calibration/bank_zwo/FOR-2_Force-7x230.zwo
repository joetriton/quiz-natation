<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>FOR-2 Force 7x2'30</name>
  <description>Force 7x2'30 à 90-95% FTP en 55 rpm. RPE jambes 8. Recrutement musculaire.
Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2→4"/>
    </Warmup>
    <IntervalsT Repeat="7" OnDuration="150" OnPower="0.93" OffDuration="150" OffPower="0.55" Cadence="55" CadenceResting="90">
      <textevent timeoffset="0" message="EFFORT — 55 rpm — RPE jambes 8"/>
      <textevent timeoffset="150" message="RÉCUP — Récup — RPE 2"/>
    </IntervalsT>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
