<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>FOR-2 Force 7x2'30</name>
  <description>7x2'30 à 90-95% FTP en 55 rpm. Recrutement musculaire. | Qualités : Force spécifique / recrutement musculaire. Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
