<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>END-5-HT Endurance longue 2h30 (home-trainer)</name>
  <description>HT 1h15 : endurance continue avec 2 touches de tempo. | Alternative HT de END-5. Qualités : Endurance aérobie fondamentale + Durabilité / résistance à la fatigue (tenue de puissance).</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="1500" Power="0.72" Cadence="88">
      <textevent timeoffset="0" message="Endurance 70-75% FTP · RPE 3-4"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.78">
      <textevent timeoffset="0" message="Touche tempo 78% · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.72" Cadence="88">
      <textevent timeoffset="0" message="Endurance 70-75% FTP · RPE 3-4"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.78">
      <textevent timeoffset="0" message="Touche tempo 78% · RPE 5"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
