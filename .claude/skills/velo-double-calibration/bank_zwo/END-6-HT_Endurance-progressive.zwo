<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>END-6-HT Endurance progressive (home-trainer)</name>
  <description>Endurance progressive 68-&gt;80% FTP. | Alternative HT de END-6. Qualités : Endurance aérobie fondamentale + Durabilité / résistance à la fatigue (tenue de puissance).</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="1601" Power="0.68" Cadence="88">
      <textevent timeoffset="0" message="68% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1601" Power="0.74" Cadence="88">
      <textevent timeoffset="0" message="74% FTP · RPE 4"/>
    </SteadyState>
    <SteadyState Duration="1067" Power="0.8" Cadence="90">
      <textevent timeoffset="0" message="80% FTP · RPE 5"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
