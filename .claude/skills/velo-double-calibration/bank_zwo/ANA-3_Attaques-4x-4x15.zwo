<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>ANA-3 Attaques 4x(4x15")</name>
  <description>4 séries de 4x15s à ~150% FTP. Répétition d'attaques. | Qualités : Capacité anaérobie (production lactique) + Puissance neuromusculaire / explosivité (sprint). Double calibration %FTP + RPE.</description>
