<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>TMP-3 Tempo 2x25</name>
  <description>Tempo 2x25 min à 80-84% FTP. Tenue mentale longue. | Qualités : Endurance soutenue sous-seuil (capacité aérobie / tempo) + Durabilité / résistance à la fatigue (tenue de puissance). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="1500" Power="0.82" Cadence="90">
      <textevent timeoffset="0" message="Tempo 80-84% FTP · RPE 5-6"/>
    </SteadyState>
    <SteadyState Duration="420" Power="0.55">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="1500" Power="0.82" Cadence="90">
      <textevent timeoffset="0" message="Tempo 80-84% FTP · RPE 5-6"/>
    </SteadyState>
    <SteadyState Duration="420" Power="0.55">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
