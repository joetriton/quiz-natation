<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>VO2-4 VO2 5x4'</name>
  <description>VO2max 5x4 min à 108-112% FTP, récup 3 min. Format long, soutenable. | Qualités : Consommation maximale d'oxygène (PMA / VO2max) + Durabilité / résistance à la fatigue (tenue de puissance). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="120" Power="0.55">
      <textevent timeoffset="0" message="Transition avant le corps — RPE 2"/>
    </SteadyState>
    <SteadyState Duration="240" Power="1.1" Cadence="95">
      <textevent timeoffset="0" message="VO2 108-112% FTP · RPE 8-9"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.5">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="240" Power="1.1" Cadence="95">
      <textevent timeoffset="0" message="VO2 108-112% FTP · RPE 8-9"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.5">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="240" Power="1.1" Cadence="95">
      <textevent timeoffset="0" message="VO2 108-112% FTP · RPE 8-9"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.5">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="240" Power="1.1" Cadence="95">
      <textevent timeoffset="0" message="VO2 108-112% FTP · RPE 8-9"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.5">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="240" Power="1.1" Cadence="95">
      <textevent timeoffset="0" message="VO2 108-112% FTP · RPE 8-9"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.5">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
