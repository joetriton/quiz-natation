<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>TMP-4 Tempo vallonné (cadence variée)</name>
  <description>Alternance 60 rpm (côte) / 95 rpm (plat) à tempo. Spécifique terrain. | Qualités : Endurance soutenue sous-seuil (capacité aérobie / tempo) + Force spécifique / recrutement musculaire. Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="180" Power="0.84" Cadence="60">
      <textevent timeoffset="0" message="Tempo 84% FTP · 60 rpm (côte) · RPE jambes 6"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.8" Cadence="95">
      <textevent timeoffset="0" message="Tempo 80% FTP · 95 rpm (plat) · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.84" Cadence="60">
      <textevent timeoffset="0" message="Tempo 84% FTP · 60 rpm (côte) · RPE jambes 6"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.8" Cadence="95">
      <textevent timeoffset="0" message="Tempo 80% FTP · 95 rpm (plat) · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.84" Cadence="60">
      <textevent timeoffset="0" message="Tempo 84% FTP · 60 rpm (côte) · RPE jambes 6"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.8" Cadence="95">
      <textevent timeoffset="0" message="Tempo 80% FTP · 95 rpm (plat) · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.84" Cadence="60">
      <textevent timeoffset="0" message="Tempo 84% FTP · 60 rpm (côte) · RPE jambes 6"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.8" Cadence="95">
      <textevent timeoffset="0" message="Tempo 80% FTP · 95 rpm (plat) · RPE 5"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
