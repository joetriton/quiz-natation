<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>END-4 Longue spécifique allure course</name>
  <description>Sortie longue avec blocs à l'allure de course. Tenue d'allure / durabilité.
Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2→4"/>
    </Warmup>
    <SteadyState Duration="1800" Power="0.7" Cadence="88">
      <textevent timeoffset="0" message="Endurance — RPE 3-4"/>
    </SteadyState>
    <IntervalsT Repeat="3" OnDuration="1200" OnPower="0.8" OffDuration="600" OffPower="0.68" Cadence="88">
      <textevent timeoffset="0" message="EFFORT — Allure course — RPE 5"/>
      <textevent timeoffset="1200" message="RÉCUP — Endurance — RPE 3"/>
    </IntervalsT>
    <SteadyState Duration="1800" Power="0.7">
      <textevent timeoffset="0" message="Retour endurance — RPE 3-4"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
