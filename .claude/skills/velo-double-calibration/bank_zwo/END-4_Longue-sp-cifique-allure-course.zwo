<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>END-4 Longue spécifique allure course</name>
  <description>Sortie longue avec blocs à l'allure de course. Durabilité / tenue d'allure. Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="1800" Power="0.7" Cadence="88">
      <textevent timeoffset="0" message="Endurance 65-75% FTP · RPE 3-4"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.8" Cadence="88">
      <textevent timeoffset="0" message="Allure course 78-82% FTP · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.68">
      <textevent timeoffset="0" message="Endurance 65-72% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.8" Cadence="88">
      <textevent timeoffset="0" message="Allure course 78-82% FTP · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.68">
      <textevent timeoffset="0" message="Endurance 65-72% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.8" Cadence="88">
      <textevent timeoffset="0" message="Allure course 78-82% FTP · RPE 5"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.68">
      <textevent timeoffset="0" message="Endurance 65-72% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.7">
      <textevent timeoffset="0" message="Retour endurance 65-75% FTP · RPE 3-4"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
