<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>SEU-1 Seuil 2x15</name>
  <description>Seuil 2x15 min à 95-100% FTP, RPE 7-8. Élève la FTP.
Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2→4"/>
    </Warmup>
    <IntervalsT Repeat="3" OnDuration="30" OnPower="1.05" OffDuration="60" OffPower="0.5">
      <textevent timeoffset="0" message="EFFORT — RPE 8 (activation)"/>
      <textevent timeoffset="30" message="RÉCUP — RPE 2"/>
    </IntervalsT>
    <SteadyState Duration="120" Power="0.55">
      <textevent timeoffset="0" message="Transition avant le corps de séance — RPE 2"/>
    </SteadyState>
    <IntervalsT Repeat="2" OnDuration="900" OnPower="0.98" OffDuration="480" OffPower="0.5" Cadence="90">
      <textevent timeoffset="0" message="EFFORT — Seuil — RPE 7-8 — mots isolés"/>
      <textevent timeoffset="900" message="RÉCUP — Récup — RPE 2"/>
    </IntervalsT>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
