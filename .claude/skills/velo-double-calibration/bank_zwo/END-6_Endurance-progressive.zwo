<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>END-6 Endurance progressive</name>
  <description>Endurance montant de 65% à 78% FTP. Tenue d'allure croissante. | Qualités : Endurance aérobie fondamentale + Durabilité / résistance à la fatigue (tenue de puissance). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="1200" Power="0.65" Cadence="88">
      <textevent timeoffset="0" message="65% FTP · RPE 3"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.7" Cadence="88">
      <textevent timeoffset="0" message="70% FTP · RPE 3-4"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.74" Cadence="88">
      <textevent timeoffset="0" message="74% FTP · RPE 4"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.78" Cadence="90">
      <textevent timeoffset="0" message="78% FTP · RPE 5"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
