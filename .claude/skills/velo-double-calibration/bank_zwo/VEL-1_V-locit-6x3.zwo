<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>VEL-1 Vélocité 6x3'</name>
  <description>6x3 min à 108-112 rpm, 70% FTP. Fluidité du coup de pédale. | Qualités : Vélocité &amp; coordination neuromusculaire (cadence, fluidité) + Endurance aérobie fondamentale. Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
