<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>VEL-4 Pyramide de cadence</name>
  <description>Cadence 80-&gt;110-&gt;80 rpm à 62% FTP. Plage de cadence. | Qualités : Vélocité &amp; coordination neuromusculaire (cadence, fluidité) + Endurance aérobie fondamentale. Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="180" Power="0.62" Cadence="80">
      <textevent timeoffset="0" message="62% · 80 rpm"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.62" Cadence="90">
      <textevent timeoffset="0" message="62% · 90 rpm"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.62" Cadence="100">
      <textevent timeoffset="0" message="62% · 100 rpm"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.62" Cadence="110">
      <textevent timeoffset="0" message="62% · 110 rpm"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.62" Cadence="100">
      <textevent timeoffset="0" message="62% · 100 rpm"/>
    </SteadyState>
    <SteadyState Duration="180" Power="0.62" Cadence="90">
      <textevent timeoffset="0" message="62% · 90 rpm"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
