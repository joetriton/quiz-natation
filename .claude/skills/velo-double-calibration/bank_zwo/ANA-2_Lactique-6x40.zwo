<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>ANA-2 Lactique 6x40"</name>
  <description>6x40s à ~130% FTP, récup 3 min. Production/tolérance lactique. | Qualités : Capacité anaérobie (production lactique) + Tolérance lactique / capacité à répéter l'effort. Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="120" Power="0.55">
      <textevent timeoffset="0" message="Transition avant le corps — RPE 2"/>
    </SteadyState>
    <SteadyState Duration="40" Power="1.3" Cadence="100">
      <textevent timeoffset="0" message="Lactique ~130% FTP · RPE 9-10"/>
    </SteadyState>
    <SteadyState Duration="200" Power="0.5">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="40" Power="1.3" Cadence="100">
      <textevent timeoffset="0" message="Lactique ~130% FTP · RPE 9-10"/>
    </SteadyState>
    <SteadyState Duration="200" Power="0.5">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="40" Power="1.3" Cadence="100">
      <textevent timeoffset="0" message="Lactique ~130% FTP · RPE 9-10"/>
    </SteadyState>
    <SteadyState Duration="200" Power="0.5">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="40" Power="1.3" Cadence="100">
      <textevent timeoffset="0" message="Lactique ~130% FTP · RPE 9-10"/>
    </SteadyState>
    <SteadyState Duration="200" Power="0.5">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="40" Power="1.3" Cadence="100">
      <textevent timeoffset="0" message="Lactique ~130% FTP · RPE 9-10"/>
    </SteadyState>
    <SteadyState Duration="200" Power="0.5">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="40" Power="1.3" Cadence="100">
      <textevent timeoffset="0" message="Lactique ~130% FTP · RPE 9-10"/>
    </SteadyState>
    <SteadyState Duration="200" Power="0.5">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
