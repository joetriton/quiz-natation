<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>SS-1 Sweet Spot 3x12</name>
  <description>Sweet Spot 3x12 min à 88-92% FTP, RPE 6-7. | Qualités : Charge aérobie optimisée (sweet spot). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="120" Power="0.55">
      <textevent timeoffset="0" message="Transition avant le corps — RPE 2"/>
    </SteadyState>
    <SteadyState Duration="720" Power="0.9" Cadence="90">
      <textevent timeoffset="0" message="Sweet Spot 88-92% FTP · RPE 6-7 — tenable"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Récup 50-58% FTP · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="720" Power="0.9" Cadence="90">
      <textevent timeoffset="0" message="Sweet Spot 88-92% FTP · RPE 6-7 — tenable"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Récup 50-58% FTP · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="720" Power="0.9" Cadence="90">
      <textevent timeoffset="0" message="Sweet Spot 88-92% FTP · RPE 6-7 — tenable"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Récup 50-58% FTP · RPE 2"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
