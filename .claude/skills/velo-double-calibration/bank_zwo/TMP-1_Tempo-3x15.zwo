<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>TMP-1 Tempo 3x15</name>
  <description>Tempo 3x15 min à 80-85% FTP, RPE 5-6. | Qualités : Endurance soutenue sous-seuil (capacité aérobie / tempo). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="900" Power="0.83" Cadence="90">
      <textevent timeoffset="0" message="Tempo 80-85% FTP · RPE 5-6 — phrases courtes"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Récup 50-58% FTP · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.83" Cadence="90">
      <textevent timeoffset="0" message="Tempo 80-85% FTP · RPE 5-6 — phrases courtes"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Récup 50-58% FTP · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.83" Cadence="90">
      <textevent timeoffset="0" message="Tempo 80-85% FTP · RPE 5-6 — phrases courtes"/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Récup 50-58% FTP · RPE 2"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
