<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>END-2 Endurance fond 70'</name>
  <description>Endurance fondamentale. 65-75% FTP, RPE 3-4. Base aérobie. | Qualités : Endurance aérobie fondamentale + Métabolisme lipidique (fat-max, oxydation des graisses). Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="4200" Power="0.7" Cadence="88">
      <textevent timeoffset="0" message="Endurance 65-75% FTP · RPE 3-4 — conversation fluide"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
