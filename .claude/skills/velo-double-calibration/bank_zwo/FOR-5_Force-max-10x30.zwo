<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>FOR-5 Force max 10x30"</name>
  <description>10x30s à ~100% FTP en 45-50 rpm (couple max), récup 2'30. | Qualités : Force maximale (couple, basse cadence forte résistance) + Force spécifique / recrutement musculaire. Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
