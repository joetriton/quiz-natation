<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>RACE-HD Allure course demi-distance (IF 0.78)</name>
  <description>Tenue d'allure demi-distance : 1h continu à 78-80% FTP, RPE 5-6. Partie vélo d'un brick. Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="3600" Power="0.79" Cadence="90">
      <textevent timeoffset="0" message="Allure course HD — RPE 5-6 — IF 0.78"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
