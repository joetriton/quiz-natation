<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>SEU-7 Seuil over-under 3x9</name>
  <description>3 blocs de 9 min en 2'under/1'over (90%/105% FTP). Relances au seuil. | Qualités : Puissance au seuil (FTP / seuil lactique) + Tolérance lactique / capacité à répéter l'effort. Double calibration %FTP + RPE.</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
