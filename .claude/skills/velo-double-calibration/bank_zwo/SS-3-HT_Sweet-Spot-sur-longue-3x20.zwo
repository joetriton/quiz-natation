<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Skill velo-double-calibration</author>
  <name>SS-3-HT Sweet Spot sur longue 3x20 (home-trainer)</name>
  <description>HT 1h20 : sweet spot 3x15' (sans le volume endurance de la route). | Alternative HT de SS-3. Qualités : Charge aérobie optimisée (sweet spot) + Durabilité / résistance à la fatigue (tenue de puissance).</description>
  <sportType>bike</sportType>
  <tags><tag name="DoubleCalibration"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.72">
      <textevent timeoffset="0" message="Échauffement progressif — RPE 2-&gt;4"/>
    </Warmup>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="30" Power="1.05">
      <textevent timeoffset="0" message="RPE 8 (activation)"/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.5">
      <textevent timeoffset="0" message="RPE 2"/>
    </SteadyState>
    <SteadyState Duration="120" Power="0.55">
      <textevent timeoffset="0" message="Transition avant le corps — RPE 2"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9" Cadence="90">
      <textevent timeoffset="0" message="Sweet Spot 88-92% FTP · RPE 6-7"/>
    </SteadyState>
    <SteadyState Duration="240" Power="0.55">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9" Cadence="90">
      <textevent timeoffset="0" message="Sweet Spot 88-92% FTP · RPE 6-7"/>
    </SteadyState>
    <SteadyState Duration="240" Power="0.55">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.9" Cadence="90">
      <textevent timeoffset="0" message="Sweet Spot 88-92% FTP · RPE 6-7"/>
    </SteadyState>
    <SteadyState Duration="240" Power="0.55">
      <textevent timeoffset="0" message="récup · RPE 2"/>
    </SteadyState>
    <Cooldown Duration="480" PowerLow="0.6" PowerHigh="0.45">
      <textevent timeoffset="0" message="Retour au calme — RPE 2"/>
    </Cooldown>
  </workout>
</workout_file>
